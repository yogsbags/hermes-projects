{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aveyroni.local/schemas/company.json",
  "title": "TargetCard",
  "description": "Shortlisted company. Every important statement points at an evidence id.",
  "type": "object",
  "additionalProperties": false,
  "required": ["company_id", "legal_name"],
  "properties": {
    "company_id": { "type": "string" },
    "legal_name": { "type": "string" },
    "display_name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "domain": { "type": "string" },
    "cin": { "type": "string" },
    "registration_id": { "type": "string" },
    "registration_jurisdiction": { "type": "string" },
    "locations": { "type": "array", "items": { "type": "string" } },
    "plants": { "type": "array", "items": { "type": "string" } },
    "products": { "type": "array", "items": { "type": "string" } },
    "customers": { "type": "string" },
    "exports": { "type": "array", "items": { "type": "string" } },
    "revenue_estimate_inr_cr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "low": { "type": ["number", "null"] },
        "high": { "type": ["number", "null"] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "revenue_estimate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "low": { "type": ["number", "null"] },
        "high": { "type": ["number", "null"] },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "scale": { "enum": ["million", "billion", "crore", null] },
        "confidence": { "enum": ["high", "medium", "low", "unknown"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "ebitda": {
      "description": "Use the string unknown when no sourced figure exists.",
      "type": ["string", "object"]
    },
    "ownership_summary": { "type": "string" },
    "why_it_fits": { "type": "array", "items": { "type": "string" } },
    "value_creation_hypotheses": { "type": "array", "items": { "type": "string" } },
    "red_team": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "evidence_ids": { "type": "array", "items": { "type": "string" } }
  }
}
